# Local dev: copy to ".env". The default talks to a backend on localhost:8000.
VITE_API_URL=http://localhost:8000

# Production (Vercel): set VITE_API_URL in the Vercel project's Environment
# Variables to your deployed backend's PUBLIC URL, e.g.
#   VITE_API_URL=https://chill-knight-backend.onrender.com
# The app derives the WebSocket URL from this automatically (https -> wss).
# It's read at BUILD time, so redeploy after changing it.
