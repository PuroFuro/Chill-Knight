# Copy this file to ".env" and adjust as needed.

# --- Database ---
# PostgreSQL (recommended / production, matches the project spec):
#   DATABASE_URL=postgresql+asyncpg://chill:chill@localhost:5432/chill_knight
# SQLite (zero-setup local dev fallback — used if DATABASE_URL is unset):
DATABASE_URL=sqlite+aiosqlite:///./chill_knight.db

# --- Auth ---
# Change this to a long random string in production.
SECRET_KEY=change-me-in-production-please-use-a-long-random-string

# --- CORS ---
# Comma separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
