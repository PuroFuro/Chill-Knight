# Copy this file to ".env" and adjust as needed.

# --- Database ---
# Supabase (recommended / production). Grab this from your Supabase project at
# Settings -> Database -> Connection string (the "URI" form) and swap the scheme
# to postgresql+asyncpg. Examples:
#   Direct connection (port 5432):
#     DATABASE_URL=postgresql+asyncpg://postgres:<PASSWORD>@db.<REF>.supabase.co:5432/postgres
#   Transaction pooler (port 6543, for serverless / many short connections):
#     DATABASE_URL=postgresql+asyncpg://postgres.<REF>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
# SQLite (zero-setup local dev fallback — used if DATABASE_URL is unset):
DATABASE_URL=sqlite+aiosqlite:///./chill_knight.db

# --- Auth ---
# Change this to a long random string in production.
SECRET_KEY=change-me-in-production-please-use-a-long-random-string

# --- CORS ---
# Comma separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
