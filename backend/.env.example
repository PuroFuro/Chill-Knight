# Local dev: copy this file to ".env" and adjust.
# Production (Render/Railway/Fly/etc.): set these as ENVIRONMENT VARIABLES in the
# host's dashboard instead of committing a .env file.

# --- Database (required in production) ---
# Supabase Postgres. Grab the URI from your Supabase project at
# Settings -> Database -> Connection string (URI form) and swap the scheme to
# postgresql+asyncpg. Use the TRANSACTION POOLER host (port 6543) for hosted
# deployments — asyncpg's prepared-statement cache is auto-disabled for Supabase
# URLs so pgbouncer works.
#   DATABASE_URL=postgresql+asyncpg://postgres.<REF>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:<PASSWORD>@db.<REF>.supabase.co:5432/postgres

# --- Auth (required in production) ---
# Signs login tokens. MUST be a long random string in production — anyone who
# knows it can forge accounts. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string

# --- CORS (required in production) ---
# Comma-separated list of allowed frontend origins. Add your Vercel URL(s).
# No trailing slash. Example:
#   CORS_ORIGINS=https://chill-knight.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
